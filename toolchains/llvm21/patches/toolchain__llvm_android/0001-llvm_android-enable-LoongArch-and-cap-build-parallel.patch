From 21673b49ee2f7733617923a2f7950ec5bb5ca9bd Mon Sep 17 00:00:00 2001
From: noctis <970308389@qq.com>
Date: Sun, 19 Jul 2026 13:15:19 +0800
Subject: [PATCH 1/9] llvm_android: enable LoongArch and cap build parallelism

Change-Id: I36c666f68d631757db825843f66a553da2d465c8
---
 src/llvm_android/base_builders.py | 3 ++-
 src/llvm_android/constants.py     | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/llvm_android/base_builders.py b/src/llvm_android/base_builders.py
index ac11750..c8a9185 100644
--- a/src/llvm_android/base_builders.py
+++ b/src/llvm_android/base_builders.py
@@ -467,7 +467,8 @@ class CMakeBuilder(Builder):
                 args: ninja targets to build
                 add_env: additional environment variables
         """
-        ninja_cmd = [str(paths.NINJA_BIN_PATH)] + args
+        # Keep peak LLVM compiler memory below this host's 20 GiB RAM limit.
+        ninja_cmd = [str(paths.NINJA_BIN_PATH), '-j12'] + args
         if add_env:
             ninja_env = self.env.copy()
             ninja_env.update(add_env)
diff --git a/src/llvm_android/constants.py b/src/llvm_android/constants.py
index 27ff397..2930c31 100644
--- a/src/llvm_android/constants.py
+++ b/src/llvm_android/constants.py
@@ -31,4 +31,6 @@ HOST_TARGETS: Set[str] = set(['X86'])
 DARWIN_HOST_TARGETS: Set[str] = set(['X86', 'AArch64'])
 
 # Targets for Android.
-ANDROID_TARGETS: Set[str] = set(['AArch64', 'ARM', 'BPF', 'RISCV', 'WebAssembly', 'X86'])
+ANDROID_TARGETS: Set[str] = set([
+    'AArch64', 'ARM', 'BPF', 'LoongArch', 'RISCV', 'WebAssembly', 'X86'
+])
-- 
