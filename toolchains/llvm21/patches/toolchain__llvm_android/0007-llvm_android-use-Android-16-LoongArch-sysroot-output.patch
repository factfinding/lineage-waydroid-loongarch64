From 00060861d386b418eacbdefe4398c0608fcab4af Mon Sep 17 00:00:00 2001
From: noctis <970308389@qq.com>
Date: Mon, 3 Aug 2026 14:31:06 +0800
Subject: [PATCH 7/9] llvm_android: use Android 16 LoongArch sysroot outputs

Prepare the LoongArch runtime sysroot from the Android 16 current-API bionic artifacts and use the checked-out NDK r28 sysroot as the header template. Allow callers to override the NDK sysroot when needed.

Change-Id: I493df13bdc345f8be34a3da05370d2a3b1d7e12e
---
 scripts/prepare_loongarch64_libcxx_sysroot.sh | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/scripts/prepare_loongarch64_libcxx_sysroot.sh b/scripts/prepare_loongarch64_libcxx_sysroot.sh
index 11de78f..f5f17ec 100755
--- a/scripts/prepare_loongarch64_libcxx_sysroot.sh
+++ b/scripts/prepare_loongarch64_libcxx_sysroot.sh
@@ -6,7 +6,7 @@ llvm_android="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 toolchain="$(cd "${llvm_android}/../.." && pwd)"
 workspace="$(cd "${toolchain}/.." && pwd)"
 aosp="${AOSP_ROOT:-${workspace}/lineage-waydroid-23.2}"
-template="${toolchain}/toolchain/prebuilts/sysroot/platform/riscv64-linux-android"
+template="${ANDROID_NDK_SYSROOT:-${toolchain}/toolchain/prebuilts/ndk/releases/r28/toolchains/llvm/prebuilt/linux-x86_64/sysroot}"
 dest="${toolchain}/out/loongarch64-android-sysroot-source"
 triple="loongarch64-linux-android"
 libdir="${dest}/usr/lib/${triple}"
@@ -14,7 +14,7 @@ api_libdir="${libdir}/10000"
 bootstrap_builtins="${LOONGARCH64_BOOTSTRAP_BUILTINS:-${workspace}/aosp/prebuilts/clang/host/linux-x86/clang-r547379/lib/clang/20/lib/linux/libclang_rt.builtins-loongarch64-android.a}"
 
 test -d "${template}/usr/include"
-test -f "${aosp}/out/soong/.intermediates/bionic/libc/libc/android_loongarch64_shared/libc.so"
+test -f "${aosp}/out/soong/.intermediates/bionic/libc/libc/android_loongarch64_shared_current/libc.so"
 
 mkdir -p "${dest}/usr/include" "${api_libdir}"
 rsync -a --delete \
@@ -38,7 +38,7 @@ for library in libc/libc libm/libm libdl/libdl; do
     module="${library%/*}"
     name="${library#*/}"
     install -m 0644 \
-        "${aosp}/out/soong/.intermediates/bionic/${module}/${name}/android_loongarch64_shared/${name}.so" \
+        "${aosp}/out/soong/.intermediates/bionic/${module}/${name}/android_loongarch64_shared_current/${name}.so" \
         "${api_libdir}/${name}.so"
 done
 install -m 0644 \
