From db3f113c833ee70f886a1adea81015a7eec89e23 Mon Sep 17 00:00:00 2001
From: noctis <970308389@qq.com>
Date: Mon, 3 Aug 2026 13:13:31 +0800
Subject: [PATCH] rust: enable the LoongArch LLVM target

Change-Id: I19a3458e107f2b62133b88988b72d4ef4ed5c949
---
 templates/config.toml.template | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/templates/config.toml.template b/templates/config.toml.template
index d9ec7e2..06d4cb9 100644
--- a/templates/config.toml.template
+++ b/templates/config.toml.template
@@ -3,7 +3,7 @@ change-id = 131075
 [llvm]
 download-ci-llvm = false
 ninja = true
-targets = "AArch64;ARM;X86;RISCV"
+targets = "AArch64;ARM;X86;RISCV;LoongArch"
 link-shared = $llvm_link_shared
 cflags = "$llvm_cflags"
 cxxflags = "$llvm_cxxflags"
@@ -20,6 +20,7 @@ CMAKE_BUILD_RPATH = "$llvm_cxx_runtime_path_host"
 $zstd_config
 
 [build]
+jobs = 8
 build = "$stage0_host_triple"
 host = ["$new_host_triple"]
 target = [$all_targets]
-- 
