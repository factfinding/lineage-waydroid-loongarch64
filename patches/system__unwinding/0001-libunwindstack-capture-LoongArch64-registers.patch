From bbbc8bbe5fbc175466ba8f7cc690605f827c030c Mon Sep 17 00:00:00 2001
From: noctis <970308389@qq.com>
Date: Mon, 3 Aug 2026 15:38:13 +0800
Subject: [PATCH] libunwindstack: capture LoongArch64 registers

Change-Id: I0e0ae7eb87abda4c9d6803a2f4a9b7a9b5e69475
---
 .../include/unwindstack/RegsGetLocal.h        | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/libunwindstack/include/unwindstack/RegsGetLocal.h b/libunwindstack/include/unwindstack/RegsGetLocal.h
index e3c1092..392808e 100644
--- a/libunwindstack/include/unwindstack/RegsGetLocal.h
+++ b/libunwindstack/include/unwindstack/RegsGetLocal.h
@@ -131,6 +131,49 @@ inline __attribute__((__always_inline__)) void AsmGetRegs(void* reg_data) {
       : "t1", "memory");
 }
 
+#elif defined(__loongarch__)
+
+inline __attribute__((__always_inline__)) void AsmGetRegs(void* reg_data) {
+  asm volatile(
+      "1:\n"
+      "st.d $r1, %[base], 8\n"
+      "st.d $r3, %[base], 16\n"
+      "st.d $r4, %[base], 24\n"
+      "st.d $r5, %[base], 32\n"
+      "st.d $r6, %[base], 40\n"
+      "st.d $r7, %[base], 48\n"
+      "st.d $r8, %[base], 56\n"
+      "st.d $r9, %[base], 64\n"
+      "st.d $r10, %[base], 72\n"
+      "st.d $r11, %[base], 80\n"
+      "st.d $r12, %[base], 88\n"
+      "st.d $r13, %[base], 96\n"
+      "st.d $r14, %[base], 104\n"
+      "st.d $r15, %[base], 112\n"
+      "st.d $r16, %[base], 120\n"
+      "st.d $r17, %[base], 128\n"
+      "st.d $r18, %[base], 136\n"
+      "st.d $r19, %[base], 144\n"
+      "st.d $r20, %[base], 152\n"
+      "st.d $r21, %[base], 160\n"
+      "st.d $r22, %[base], 168\n"
+      "st.d $r23, %[base], 176\n"
+      "st.d $r24, %[base], 184\n"
+      "st.d $r25, %[base], 192\n"
+      "st.d $r26, %[base], 200\n"
+      "st.d $r27, %[base], 208\n"
+      "st.d $r28, %[base], 216\n"
+      "st.d $r29, %[base], 224\n"
+      "st.d $r30, %[base], 232\n"
+      "st.d $r31, %[base], 240\n"
+      // pc saved at offset 0
+      "la.pcrel $r12, 1b\n"
+      "st.d $r12, %[base], 0\n"
+      : [base] "+r"(reg_data)
+      :
+      : "$r12", "memory");
+}
+
 #elif defined(__i386__) || defined(__x86_64__)
 
 // Do not change this, some libraries depend on this function existing on
-- 
2.43.0

