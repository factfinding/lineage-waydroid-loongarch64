 .../include/llvm/Config/AsmParsers.def        |  3 ++
 .../include/llvm/Config/AsmPrinters.def       |  3 ++
 .../include/llvm/Config/Disassemblers.def     |  3 ++
 .../android/include/llvm/Config/Targets.def   |  3 ++
 .../android/include/llvm/Config/llvm-config.h | 18 ++++++++++
 .../llvm-16.0/scripts/generate_build_files.py |  3 +-
 .../llvm-16.0/scripts/template_Android.bp     |  7 ++++
 third_party/llvm-16.0/scripts/update.py       |  1 +
 9 files changed, 73 insertions(+), 1 deletion(-)

