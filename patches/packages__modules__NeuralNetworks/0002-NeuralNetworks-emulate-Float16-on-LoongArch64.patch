+#pragma once
+
+#include <Eigen/Core>
+#include <bit>
+#include <cstdint>
+#include <type_traits>
+
+// Clang does not expose _Float16 for LoongArch yet. Eigen::half has the same
+// two-byte IEEE 754 binary16 representation and supplies portable arithmetic.
+// Its conversions from arithmetic types are explicit, while _Float16 permits
+// implicit conversions, so retain those language semantics in a thin wrapper.
+namespace android::nn::loongarch {
+
+struct Float16 : public Eigen::half {
+   private:
+    static constexpr uint16_t floatToHalfBits(float value) {
+        const uint32_t bits = std::bit_cast<uint32_t>(value);
+        const uint16_t sign = static_cast<uint16_t>((bits >> 16) & 0x8000);
+        const uint32_t exponent = (bits >> 23) & 0xff;
+        uint32_t significand = bits & 0x7fffff;
+
+        if (exponent == 0xff) {
+            return sign | (significand == 0 ? 0x7c00 : 0x7e00);
+        }
+
+        const int halfExponent = static_cast<int>(exponent) - 127 + 15;
+        if (halfExponent >= 31) {
+            return sign | 0x7c00;
+        }
+        if (halfExponent <= 0) {
+            if (halfExponent < -10) {
+                return sign;
+            }
+            significand |= 0x800000;
+            const int shift = 14 - halfExponent;
+            uint32_t halfSignificand = significand >> shift;
+            const uint32_t remainder = significand & ((uint32_t{1} << shift) - 1);
+            const uint32_t halfway = uint32_t{1} << (shift - 1);
+            if (remainder > halfway || (remainder == halfway && (halfSignificand & 1) != 0)) {
+                ++halfSignificand;
+            }
+            return sign | static_cast<uint16_t>(halfSignificand);
+        }
+
+        uint32_t halfSignificand = significand >> 13;
+        const uint32_t remainder = significand & 0x1fff;
+        if (remainder > 0x1000 || (remainder == 0x1000 && (halfSignificand & 1) != 0)) {
+            ++halfSignificand;
+        }
+        return sign | static_cast<uint16_t>((halfExponent << 10) + halfSignificand);
+    }
+
+   public:
+    Float16() = default;
+    Float16(const Float16&) = default;
+    Float16(const Eigen::half& value) : Eigen::half(value) {}
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    constexpr Float16(T value)
+        : Eigen::half(Eigen::half_impl::raw_uint16_to_half(
+                  floatToHalfBits(static_cast<float>(value)))) {}
+
+    Float16& operator=(const Float16&) = default;
+
+    Float16& operator=(const Eigen::half& value) {
+        x = value.x;
+        return *this;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    Float16& operator=(T value) {
+        x = Eigen::half(static_cast<float>(value)).x;
+        return *this;
+    }
+
+    Float16& operator+=(Float16 value) {
+        return *this = static_cast<float>(*this) + static_cast<float>(value);
+    }
+    Float16& operator-=(Float16 value) {
+        return *this = static_cast<float>(*this) - static_cast<float>(value);
+    }
+    Float16& operator*=(Float16 value) {
+        return *this = static_cast<float>(*this) * static_cast<float>(value);
+    }
+    Float16& operator/=(Float16 value) {
+        return *this = static_cast<float>(*this) / static_cast<float>(value);
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    Float16& operator+=(T value) {
+        return *this = static_cast<float>(*this) + value;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    Float16& operator-=(T value) {
+        return *this = static_cast<float>(*this) - value;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    Float16& operator*=(T value) {
+        return *this = static_cast<float>(*this) * value;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    Float16& operator/=(T value) {
+        return *this = static_cast<float>(*this) / value;
+    }
+
+    friend Float16 operator+(Float16 lhs, Float16 rhs) { return lhs += rhs; }
+    friend Float16 operator-(Float16 lhs, Float16 rhs) { return lhs -= rhs; }
+    friend Float16 operator*(Float16 lhs, Float16 rhs) { return lhs *= rhs; }
+    friend Float16 operator/(Float16 lhs, Float16 rhs) { return lhs /= rhs; }
+    friend constexpr Float16 operator-(Float16 value) {
+        value.x ^= 0x8000;
+        return value;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator+(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) + rhs;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator-(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) - rhs;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator*(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) * rhs;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator/(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) / rhs;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator+(T lhs, Float16 rhs) {
+        return lhs + static_cast<float>(rhs);
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator-(T lhs, Float16 rhs) {
+        return lhs - static_cast<float>(rhs);
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator*(T lhs, Float16 rhs) {
+        return lhs * static_cast<float>(rhs);
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend auto operator/(T lhs, Float16 rhs) {
+        return lhs / static_cast<float>(rhs);
+    }
+
+    friend bool operator==(Float16 lhs, Float16 rhs) {
+        return static_cast<float>(lhs) == static_cast<float>(rhs);
+    }
+    friend bool operator!=(Float16 lhs, Float16 rhs) { return !(lhs == rhs); }
+    friend bool operator<(Float16 lhs, Float16 rhs) {
+        return static_cast<float>(lhs) < static_cast<float>(rhs);
+    }
+    friend bool operator<=(Float16 lhs, Float16 rhs) { return !(rhs < lhs); }
+    friend bool operator>(Float16 lhs, Float16 rhs) { return rhs < lhs; }
+    friend bool operator>=(Float16 lhs, Float16 rhs) { return !(lhs < rhs); }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator==(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) == rhs;
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator!=(Float16 lhs, T rhs) {
+        return !(lhs == rhs);
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator<(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) < rhs;
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator<=(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) <= rhs;
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator>(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) > rhs;
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator>=(Float16 lhs, T rhs) {
+        return static_cast<float>(lhs) >= rhs;
+    }
+
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator==(T lhs, Float16 rhs) {
+        return rhs == lhs;
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator!=(T lhs, Float16 rhs) {
+        return !(lhs == rhs);
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator<(T lhs, Float16 rhs) {
+        return lhs < static_cast<float>(rhs);
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator<=(T lhs, Float16 rhs) {
+        return lhs <= static_cast<float>(rhs);
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator>(T lhs, Float16 rhs) {
+        return lhs > static_cast<float>(rhs);
+    }
+    template <typename T, std::enable_if_t<std::is_arithmetic_v<T>, int> = 0>
+    friend bool operator>=(T lhs, Float16 rhs) {
+        return lhs >= static_cast<float>(rhs);
+    }
+};
+
+static_assert(sizeof(Float16) == sizeof(uint16_t));
+static_assert(alignof(Float16) == alignof(uint16_t));
+
+}  // namespace android::nn::loongarch
+
+#define _Float16 ::android::nn::loongarch::Float16
