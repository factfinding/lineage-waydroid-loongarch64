From 722be37992483615bb04a497b9446ac0a2120575 Mon Sep 17 00:00:00 2001
From: noctis <970308389@qq.com>
Date: Sat, 19 Sep 2026 10:35:23 +0800
Subject: [PATCH 2/2] minigbm: align planar imports and map complete R8 backing

Honor pre-Navi amdgpu linear pitch alignment for spoofed YUV buffers,
including chroma strides. Map the same two-dimensional R8 backing used
by allocation/import so updates reach every row. Add EGL import tests.

Validation: YUV import and native video playback controls passed on RX480.

Change-Id: I46a6521ea5b9aa8963e5dc63fb0d6db8bde8ebbd
---
 gbm_mesa_driver/gbm_mesa_internals.cpp |  43 +++++-
 tests/yuv-import/Android.bp            |   7 +
 tests/yuv-import/README.md             |  15 ++
 tests/yuv-import/yuv_import_test.cpp   | 192 +++++++++++++++++++++++++
 4 files changed, 256 insertions(+), 1 deletion(-)
 create mode 100644 tests/yuv-import/Android.bp
 create mode 100644 tests/yuv-import/README.md
 create mode 100644 tests/yuv-import/yuv_import_test.cpp

diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index 649bca7..0b7af54 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -27,6 +27,7 @@ extern "C" {
 #include "util.h"
 #include <algorithm>
 #include <array>
+#include <amdgpu_drm.h>
 #include <assert.h>
 #include <cutils/properties.h>
 #include <dlfcn.h>
@@ -106,6 +107,7 @@ struct GbmMesaDriver {
 	struct gbm_device *gbm_dev = nullptr;
 	void *dl_handle = nullptr;
 
+	uint32_t planar_stride_alignment = 1;
 	UniqueFd gbm_node_fd;
 	UniqueFd gpu_node_fd;
 };
@@ -199,6 +201,27 @@ static std::shared_ptr<GbmMesaDriver> gbm_mesa_get_or_init_driver(struct driver
 			return nullptr;
 		}
 
+		/* Spoofed planar allocations must also satisfy the GPU's import
+		 * alignment. Match the native amdgpu backend on GPUs which allow
+		 * a custom linear pitch. Leave Navi and newer GPUs, which have
+		 * additional pitch restrictions, unchanged here.
+		 */
+		drmVersionPtr version = drmGetVersion(gbm_mesa_drv->gbm_node_fd.Get());
+		if (version && strcmp(version->name, "amdgpu") == 0) {
+			struct drm_amdgpu_info_device info = {};
+			struct drm_amdgpu_info query = {};
+			query.return_pointer = reinterpret_cast<uintptr_t>(&info);
+			query.return_size = sizeof(info);
+			query.query = AMDGPU_INFO_DEV_INFO;
+			if (drmCommandWriteRead(gbm_mesa_drv->gbm_node_fd.Get(), DRM_AMDGPU_INFO,
+						&query, sizeof(query)) == 0 &&
+			    info.family < AMDGPU_FAMILY_NV) {
+				gbm_mesa_drv->planar_stride_alignment = 256;
+			}
+		}
+		if (version)
+			drmFreeVersion(version);
+
 #ifndef EMBEDDED_GBM_WRAPPER
 		gbm_mesa_drv->dl_handle = dlopen(GBM_WRAPPER_NAME, RTLD_NOW);
 		if (gbm_mesa_drv->dl_handle == nullptr) {
@@ -354,7 +377,16 @@ int gbm_mesa_bo_create2(struct bo *bo, uint32_t width, uint32_t height, uint32_t
 
 	if (alloc_args.drm_format == 0) {
 		/* Always use linear for spoofed format allocations. */
-		drv_bo_from_format(bo, alloc_args.width, 1, alloc_args.height, format);
+		uint32_t stride_align = drv->planar_stride_alignment;
+		uint32_t y_align = stride_align;
+		if (stride_align > 1 &&
+		    (format == DRM_FORMAT_YVU420 || format == DRM_FORMAT_YVU420_ANDROID))
+			y_align *= 2;
+		/* YV12's chroma stride is half the luma stride (rounded to 16).
+		 * Align both planes before computing offsets and allocation size.
+		 */
+		drv_bo_from_format(bo, ALIGN(alloc_args.width, y_align), stride_align,
+				   alloc_args.height, format);
 		bo_layout_ready = true;
 		bo->meta.total_size = ALIGN(bo->meta.total_size, size_align);
 		alloc_args.drm_format = DRM_FORMAT_R8;
@@ -527,6 +559,15 @@ void *gbm_mesa_bo_map(struct bo *bo, struct vma *vma, uint32_t map_flags)
 	if (wr->get_gbm_format(s_format) == 0) {
 		s_width = bo->meta.total_size;
 		s_height = 1;
+		s_format = DRM_FORMAT_R8;
+	}
+
+	/* Match the 2D R8 backing used by allocation and import. Mapping it
+	 * as one oversized row can write only the first row back to the GPU.
+	 */
+	if (s_format == DRM_FORMAT_R8 && s_height == 1) {
+		s_height = DIV_ROUND_UP(s_width, 4096);
+		s_width = 4096;
 	}
 
 	wr->map(priv->gbm_bo, s_width, s_height, &buf, &vma->priv);
diff --git a/tests/yuv-import/Android.bp b/tests/yuv-import/Android.bp
