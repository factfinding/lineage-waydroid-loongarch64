 hal/Android.bp                            |  3 ++
 hal/fake-nvram-seccomp-loongarch64.policy | 47 +++++++++++++++++++++++
 2 files changed, 50 insertions(+)
 create mode 100644 hal/fake-nvram-seccomp-loongarch64.policy

diff --git a/hal/Android.bp b/hal/Android.bp
index c21e34a..2821dd1 100644
--- a/hal/Android.bp
+++ b/hal/Android.bp
@@ -97,6 +97,9 @@ prebuilt_usr_share {
         arm64: {
             src: "fake-nvram-seccomp-arm64.policy",
         },
+        loongarch64: {
+            src: "fake-nvram-seccomp-loongarch64.policy",
+        },
         riscv64: {
             src: "fake-nvram-seccomp-riscv64.policy",
         },
diff --git a/hal/fake-nvram-seccomp-loongarch64.policy b/hal/fake-nvram-seccomp-loongarch64.policy
