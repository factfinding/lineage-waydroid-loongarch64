From 8616bfbf7e7458172c940611a01e5b8e9d78bb6b Mon Sep 17 00:00:00 2001
From: noctis <970308389@qq.com>
Date: Sun, 19 Jul 2026 18:26:52 +0800
Subject: [PATCH 1/3] llvm: recognize LoongArch64 device hosts

Allow the legacy device LLVM libraries to compile on LoongArch64 by defining the host triple. This LLVM snapshot predates the LoongArch backend, so leave native target initializers undefined and continue using the target-independent bitcode readers.

Change-Id: I890025e98bae8aa4a0333f62ad452c6a79714a34
---
 include/llvm/Config/llvm-platform-config.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/include/llvm/Config/llvm-platform-config.h b/include/llvm/Config/llvm-platform-config.h
index c9e82dabcc8..934ed6b00bc 100644
--- a/include/llvm/Config/llvm-platform-config.h
+++ b/include/llvm/Config/llvm-platform-config.h
@@ -115,6 +115,12 @@
 /* LLVM name for the native target MC init function, if available */
 #define LLVM_NATIVE_TARGETMC LLVMInitializeAArch64TargetMC
 
+#elif defined(__loongarch__)
+
+/* Host triple LLVM will be executed on. This LLVM snapshot predates the
+ * LoongArch backend, so there are no LLVM_NATIVE_* target initializers. */
+#define LLVM_HOST_TRIPLE "loongarch64-unknown-linux-gnu"
+
 #else
 
 #error "Unknown native architecture"
-- 
